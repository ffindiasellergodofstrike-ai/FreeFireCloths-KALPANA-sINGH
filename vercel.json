{
  "version": 2,
  "functions": {
    "api/private-checkout.ts": { "includeFiles": "build/private-checkout/**" }
  },
  "rewrites": [
    { "source": "/garena-checkout", "destination": "/api/private-checkout" },
    { "source": "/garenacheckout", "destination": "/api/private-checkout" },
    { "source": "/GarenaCheckout", "destination": "/api/private-checkout" },
    { "source": "/Garenacheckout", "destination": "/api/private-checkout" },
    { "source": "/garenaCheckout", "destination": "/api/private-checkout" },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/product/:id(-?[0-9]+)",
      "destination": "/product-fallback"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/garena-checkout",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }]
    },
    {
      "source": "/garenacheckout",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }]
    },
    {
      "source": "/GarenaCheckout",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }]
    },
    {
      "source": "/Garenacheckout",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }]
    },
    {
      "source": "/garenaCheckout",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    },
    {
      "source": "/(cart|checkout|login|register|my-orders|search|payment/success|payment/failure)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    }
  ],
  "cleanUrls": true,
  "outputDirectory": "dist"
}
