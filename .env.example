PAYGLOCAL_MERCHANT_ID=
PAYGLOCAL_PRIVATE_KEY=
PAYGLOCAL_PRIVATE_KEY_ID=
PAYGLOCAL_PUBLIC_KEY=
PAYGLOCAL_PUBLIC_KEY_ID=
PAYGLOCAL_CONTENT_TYPE=application/json

# Optional order confirmation email (server secrets; never VITE_ variables)
RESEND_API_KEY=
# Verified sender email address, without display-name brackets
RESEND_FROM_EMAIL=
# Generate a random secret of at least 32 characters for signed receipt tokens
ORDER_EMAIL_SECRET=
# Local emulator only; leave empty in production
RESEND_BASE_URL=

# COD confirmation: required on Vercel; server-only Firebase Admin JSON key for the existing project.
# Other supported Google-hosted servers may use Application Default Credentials. Never VITE_.
FIREBASE_SERVICE_ACCOUNT_JSON=
