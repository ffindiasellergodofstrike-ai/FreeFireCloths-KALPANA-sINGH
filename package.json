{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/build-private-checkout.mts && tsx server.ts",
    "build": "vite build && tsx scripts/build-crawler-pages.mts && tsx scripts/check-public-build.mts && tsx scripts/build-private-checkout.mts && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=build/server.cjs",
    "start": "node build/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist build",
    "lint": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "catalog:find": "tsx scripts/catalog.mts",
    "check:homepage": "tsx scripts/catalog.mts --check-homepage",
    "check:public-build": "tsx scripts/check-public-build.mts"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "core-js": "^3.49.0",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "firebase": "^12.12.1",
    "firebase-admin": "^14.2.0",
    "jose": "^6.2.9",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "payglocal-js-client": "github:PayGlocal-Technologies/payglocal-js-client",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.14.2",
    "regenerator-runtime": "^0.14.1",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-legacy": "^6.1.1",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.1.14",
    "terser": "^5.47.1",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not op_mini all",
    "not IE 11"
  ]
}
